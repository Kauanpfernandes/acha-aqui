# Copie para .env e ajuste. Nenhuma das integrações externas precisa de chave.
NODE_ENV=development
PORT=3000

# Postgres com PostGIS. O docker-compose já sobe um pronto nesta URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/achaaqui

# Troque por um segredo seu, com 32 caracteres ou mais.
JWT_SECRET=troque-isto-por-um-segredo-longo-de-verdade
JWT_EXPIRA_EM=7d

# Só mexa se quiser apontar para outro espelho das APIs públicas.
# OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org
# OPEN_PRICES_URL=https://prices.openfoodfacts.org
# OVERPASS_URL=https://overpass-api.de/api/interpreter
